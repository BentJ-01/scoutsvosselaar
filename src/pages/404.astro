---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { redirectPatterns } from '@/redirects';
import { url } from '@/lib/paths';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const patterns = redirectPatterns.map(([prefix, target]) => [base + prefix, url(target)]);
---

<BaseLayout title="Pagina niet gevonden">
  <script is:inline define:vars={{ patterns }}>
    // Old URLs of the previous site that follow a pattern (e.g. /event/...).
    for (const [prefix, target] of patterns) {
      if (location.pathname.startsWith(prefix)) location.replace(target);
    }
  </script>
  <section class="bg-forest text-cream topo">
    <div class="wrap py-16">
      <h1 class="text-5xl sm:text-6xl">Deze pagina bestaat niet</h1>
      <p class="mt-4 max-w-xl text-lg text-cream-muted">Misschien is ze verhuisd naar de nieuwe site. Begin bij de homepagina of de kalender.</p>
      <p class="mt-8 flex flex-wrap gap-3">
        <a class="btn" href={url('/')}>Naar de homepagina</a>
        <a class="btn btn-line" href={url('/kalender/')}>Kalender</a>
        <a class="btn btn-line" href={url('/takken/')}>Takken</a>
      </p>
    </div>
  </section>
</BaseLayout>
