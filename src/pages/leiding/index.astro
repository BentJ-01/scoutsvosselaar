---
import BaseLayout from '@/layouts/BaseLayout.astro';
import LeaderCard from '@/components/LeaderCard.astro';
import PageIntro from '@/components/PageIntro.astro';
import { getCurrentYear, getYearOverview } from '@/lib/content';
import { url } from '@/lib/paths';

const year = await getCurrentYear();
const overview = year ? await getYearOverview(year) : undefined;
---

<BaseLayout title="Leiding" description="De leiding van Scouts Don Bosco Vosselaar, per tak.">
  <PageIntro title="Leiding">
    {overview && `Werkjaar ${overview.year.data.label}. `}Vragen? Mail de tak of spreek de leiding aan na de vergadering.
  </PageIntro>
  <div class="wrap space-y-14 py-12">
    {
      !overview && <p class="border-y-2 border-ink py-4 text-muted">De leiding voor dit werkjaar staat nog niet online.</p>
    }
    {
      overview && overview.groupLeaders.length > 0 && (
        <section aria-labelledby="groepsleiding">
          <h2 id="groepsleiding" class="text-3xl sm:text-4xl">Groepsleiding</h2>
          <ul class="mt-6 grid grid-cols-2 gap-x-5 gap-y-9 sm:grid-cols-4 lg:grid-cols-6">
            {overview.groupLeaders.map((leader) => (
              <LeaderCard leader={leader} />
            ))}
          </ul>
        </section>
      )
    }
    {
      overview?.teams.map((team) => (
        <section aria-labelledby={`tak-${team.section.id}`}>
          <div class="flex flex-wrap items-baseline justify-between gap-3 border-b-2 border-ink pb-2">
            <h2 id={`tak-${team.section.id}`} class="flex items-center gap-3 text-3xl sm:text-4xl">
              <span class="inline-block size-5" style={`background:${team.section.data.color}`} aria-hidden="true" />
              {team.section.data.name}
            </h2>
            <a class="link" href={url(`/takken/${team.section.id}/`)}>
              Meer over de {team.section.data.name.toLowerCase()}
            </a>
          </div>
          <ul class="mt-6 grid grid-cols-2 gap-x-5 gap-y-9 sm:grid-cols-4 lg:grid-cols-6">
            {team.members.map((m) => (
              <LeaderCard leader={m.leader} color={team.section.data.color} isLead={m.isLead} />
            ))}
          </ul>
        </section>
      ))
    }
  </div>
</BaseLayout>
