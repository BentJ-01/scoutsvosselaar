---
import { Image } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageIntro from '@/components/PageIntro.astro';
import { getVoskes } from '@/lib/content';
import { monthLabel as monthYear } from '@/lib/events';
import { url } from '@/lib/paths';
import { voskeReadHref as readHref } from '@/lib/voske';

const [latest, ...older] = await getVoskes();
const fileName = (pdf: string) => pdf.split('/').pop();
---

<BaseLayout title="'t Voske" description="'t Voske, het ledenblad van Scouts Don Bosco Vosselaar.">
  <PageIntro title="'t Voske">Het ledenblad van de groep, met verslagen, foto's en wat er komt.</PageIntro>
  <div class="wrap py-12">
    {!latest && <p class="border-y-2 border-ink py-4 text-muted">Er staat nog geen editie online.</p>}
    {
      latest && (
        <section aria-labelledby="nieuwste" class="grid items-center gap-x-12 gap-y-8 sm:grid-cols-[15rem_1fr]">
          <div class="polaroid mx-auto w-52 [--tilt:-2deg] [--tape:40%] sm:w-full">
            {latest.data.cover ? (
              <Image src={latest.data.cover} alt={`Voorpagina van ${latest.data.title}`} widths={[240, 480]} sizes="15rem" class="aspect-[3/4] w-full object-cover" />
            ) : (
              <div class="grid aspect-[3/4] place-items-center bg-forest font-display text-3xl font-bold text-cream topo">'t Voske</div>
            )}
          </div>
          <div>
            <h2 id="nieuwste" class="text-3xl sm:text-4xl">
              {latest.data.title}
            </h2>
            {latest.data.date && <p class="mt-1 text-muted">Verschenen in {monthYear(latest.data.date)}</p>}
            <p class="mt-6 flex flex-wrap gap-3">
              <a class="btn" href={readHref(latest)}>
                Lezen
              </a>
              <a class="btn btn-line" href={url(latest.data.pdf!)} download={fileName(latest.data.pdf!)}>
                Downloaden<span class="sr-only"> (PDF)</span>
              </a>
            </p>
          </div>
        </section>
      )
    }
    {
      older.length > 0 && (
        <section aria-labelledby="oudere" class="mt-16 max-w-3xl">
          <h2 id="oudere" class="text-3xl">Oudere edities</h2>
          <ul class="mt-4 divide-y-2 divide-dotted divide-rule border-y-2 border-ink">
            {older.map((v) => (
              <li class="flex flex-wrap items-center justify-between gap-3 py-3">
                <span class="font-display text-xl font-bold">{v.data.title}</span>
                <span class="flex gap-5">
                  <a class="link" href={readHref(v)}>
                    Lezen<span class="sr-only"> {v.data.title}</span>
                  </a>
                  <a class="link" href={url(v.data.pdf!)} download={fileName(v.data.pdf!)}>
                    Downloaden<span class="sr-only"> {v.data.title} (PDF)</span>
                  </a>
                </span>
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </div>
</BaseLayout>
