---
import { Image } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import CampfireScene from '@/components/CampfireScene.astro';
import EventList from '@/components/EventList.astro';
import PostCard from '@/components/PostCard.astro';
import SectionList from '@/components/SectionList.astro';
import { site } from '@/site.config';
import { url } from '@/lib/paths';
import { getCurrentYear, getPosts, getScoutYears, getSectionMap, getSections, getUpcomingEvents } from '@/lib/content';
import { pinnedPost } from '@/lib/content-core';

const [sections, sectionMap, posts, events, currentYear, years] = await Promise.all([
  getSections(),
  getSectionMap(),
  getPosts(),
  getUpcomingEvents(),
  getCurrentYear(),
  getScoutYears(),
]);
const pinned = pinnedPost(posts);
const latest = posts.filter((p) => p !== pinned).slice(0, 6);
// The group photo of the active year, or the most recent one until that is taken.
const year = currentYear?.data.groupPhotos.length ? currentYear : years.find((y) => y.data.groupPhotos.length > 0);
const groupPhoto = year?.data.groupPhotos[0];
---

<BaseLayout description={`${site.name}: wat er de komende zondagen op het programma staat, nieuws van de groep en info over de takken.`}>
  <section class="border-b-2 border-ink topo-paper">
    <div class="wrap grid gap-x-14 gap-y-8 pt-8 pb-12 sm:pt-12 lg:grid-cols-[18rem_1fr]">
      <div>
        <h1 class="text-4xl sm:text-5xl">Op het programma</h1>
        <p class="mt-3 text-lg">Elke zondagnamiddag is het scouts. Hier zie je wat er de komende weken gepland staat.</p>
        <p class="mt-4"><a class="link" href={url('/kalender/')}>Volledige kalender</a></p>

        <figure class="polaroid relative z-10 mt-10 hidden max-w-xs [--tape-tilt:5deg] [--tape:18%] [--tilt:-2.5deg] lg:mb-[-9rem] lg:block">
          {
            groupPhoto ? (
              <Image
                src={groupPhoto}
                alt={`Groepsfoto, werkjaar ${year?.data.label}`}
                widths={[320, 480, 640]}
                sizes="18rem"
                class="aspect-[4/3] w-full object-cover"
              />
            ) : (
              <CampfireScene class="aspect-[4/3] w-full" />
            )
          }
          <figcaption class="polaroid-caption">{year ? `Werkjaar ${year.data.label}` : site.name}</figcaption>
        </figure>
      </div>

      <div>
        <h2 class="sr-only">Komende activiteiten</h2>
        <EventList events={events} sections={sectionMap} limit={5} upcoming />
      </div>
    </div>
  </section>

  <div class="wrap pt-14 lg:pl-[22rem]">
    {
      pinned && (
        <section aria-labelledby="mededeling" class="panel relative -rotate-[0.6deg] p-6 sm:p-8">
          <span aria-hidden="true" class="absolute -top-3 right-10 h-6 w-24 rotate-[4deg] bg-[#e8d6a0]/90" />
          <p class="label text-brand">Mededeling</p>
          <h2 id="mededeling" class="mt-3 text-3xl">
            {pinned.data.title}
          </h2>
          <p class="mt-2 max-w-2xl text-lg">{pinned.data.excerpt}</p>
          <p class="mt-5 flex flex-wrap items-center gap-x-5 gap-y-3">
            {pinned.data.buttonUrl && pinned.data.buttonLabel && (
              <a class="btn" href={pinned.data.buttonUrl}>
                {pinned.data.buttonLabel}
              </a>
            )}
            <a class="link" href={url(`/berichten/${pinned.id}/`)}>
              Lees het hele bericht<span class="sr-only">: {pinned.data.title}</span>
            </a>
          </p>
        </section>
      )
    }
  </div>

  <div class="wrap mt-16 grid gap-x-14 gap-y-16 lg:grid-cols-[1fr_20rem]">
    <section aria-labelledby="nieuws">
      <h2 id="nieuws" class="text-3xl sm:text-4xl">Nieuws</h2>
      {
        latest.length > 0 ? (
          <div class="mt-4 divide-y-2 divide-dotted divide-rule border-y-2 border-ink">
            {latest.map((post) => (
              <PostCard post={post} sections={sectionMap} />
            ))}
          </div>
        ) : (
          <p class="mt-4 border-y-2 border-ink py-4 text-muted">Nog geen berichten.</p>
        )
      }
      <p class="mt-4"><a class="link" href={url('/berichten/')}>Oudere berichten</a></p>
    </section>

    <aside aria-labelledby="lid-worden" class="self-start border-l-4 border-brand pl-5">
      <h2 id="lid-worden" class="text-2xl">Lid worden?</h2>
      <p class="mt-2">Hoe je inschrijft en hoeveel het lidgeld is, lees je op de pagina Inschrijven.</p>
      <p class="mt-3"><a class="link" href={url('/inschrijven/')}>Zo schrijf je in</a></p>
      <p class="mt-6 text-muted">Vragen? Mail naar <a class="link" href={`mailto:${site.email}`}>{site.email}</a>.</p>
    </aside>
  </div>

  <section aria-labelledby="takken" class="wrap mt-20">
    <h2 id="takken" class="text-3xl sm:text-4xl">Van kapoenen tot akabe</h2>
    <p class="mt-2 mb-5 max-w-2xl">In welke tak je kind zit, hangt af van de leeftijd. Elke tak heeft zijn eigen leiding en zijn eigen kamp.</p>
    <SectionList sections={sections} />
  </section>

  {
    groupPhoto && (
      <figure class="polaroid mx-auto mt-14 w-[85%] max-w-sm [--tape:55%] [--tilt:2deg] lg:hidden">
        <Image src={groupPhoto} alt={`Groepsfoto, werkjaar ${year?.data.label}`} widths={[320, 480, 640]} sizes="85vw" class="aspect-[4/3] w-full object-cover" />
        <figcaption class="polaroid-caption">Werkjaar {year?.data.label}</figcaption>
      </figure>
    )
  }
</BaseLayout>
