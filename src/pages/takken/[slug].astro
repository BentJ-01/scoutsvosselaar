---
import type { GetStaticPaths } from 'astro';
import { Image } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import EventList from '@/components/EventList.astro';
import LeaderCard from '@/components/LeaderCard.astro';
import Markdown from '@/components/Markdown.astro';
import PostCard from '@/components/PostCard.astro';
import CampfireScene from '@/components/CampfireScene.astro';
import { getCurrentYear, getPosts, getSectionMap, getSections, getUpcomingEvents, getYearOverview, type Section } from '@/lib/content';
import { url } from '@/lib/paths';

export const getStaticPaths = (async () => (await getSections()).map((section) => ({ params: { slug: section.id }, props: { section } }))) satisfies GetStaticPaths;

interface Props {
  section: Section;
}
const { section } = Astro.props;
const s = section.data;

const [sectionMap, allEvents, allPosts, year] = await Promise.all([getSectionMap(), getUpcomingEvents(), getPosts(), getCurrentYear()]);
const overview = year ? await getYearOverview(year) : undefined;
const team = overview?.teams.find((t) => t.section.id === section.id);
// Events for this section, plus the ones for the whole group.
const events = allEvents.filter((e) => e.data.sections.length === 0 || e.data.sections.some((r) => r.id === section.id));
const posts = allPosts.filter((p) => p.data.sections.some((r) => r.id === section.id)).slice(0, 3);
const blocks = [
  ['Wie?', s.who],
  ['Wat?', s.what],
  ['Kamp?', s.camp],
].filter(([, text]) => text);
---

<BaseLayout title={s.name} description={s.shortDescription || `${s.name} (${s.ageRange}) bij Scouts Don Bosco Vosselaar.`}>
  <section class="text-white topo" style={`background:${s.color}`}>
    <div class="wrap grid gap-8 pt-8 pb-10 sm:pt-12 md:grid-cols-[1fr_22rem] md:pb-0">
      <div class="md:pb-12">
        <nav aria-label="Kruimelpad" class="text-sm">
          <a href={url('/')} class="underline">Home</a> / <a href={url('/takken/')} class="underline">Takken</a> / <span aria-current="page">{s.name}</span>
        </nav>
        <h1 class="mt-3 text-5xl sm:text-7xl">{s.name}</h1>
        <p class="mt-2 text-xl font-bold">{s.ageRange}</p>
      </div>
      <figure class="polaroid self-end [--tape:62%] [--tape-tilt:3deg] [--tilt:2.2deg] md:mb-[-5rem]">
        {s.image ? <Image src={s.image} alt="" widths={[360, 540, 720]} sizes="(min-width: 768px) 22rem, 92vw" loading="eager" class="aspect-[4/3] w-full object-cover" /> : <CampfireScene class="aspect-[4/3] w-full" />}
        <figcaption class="polaroid-caption">De {s.name.toLowerCase()}</figcaption>
      </figure>
    </div>
  </section>

  <div class="wrap grid gap-x-14 gap-y-10 pt-10 md:grid-cols-[1fr_22rem] md:pt-24">
    <div class="space-y-8 md:-mt-14">
      {
        blocks.map(([title, text]) => (
          <section>
            <h2 class="text-3xl">{title}</h2>
            <Markdown source={text!} class="mt-2" />
          </section>
        ))
      }
    </div>

    <aside aria-labelledby="praktisch" class="panel self-start p-5">
      <h2 id="praktisch" class="text-2xl">Praktisch</h2>
      <dl class="mt-3 divide-y-2 divide-dotted divide-rule">
        <div class="py-2">
          <dt class="font-bold">Vergaderen</dt>
          <dd>{s.meetingTime}</dd>
        </div>
        <div class="py-2">
          <dt class="font-bold">Leeftijd</dt>
          <dd>{s.ageRange}</dd>
        </div>
        {
          s.email && (
            <div class="py-2">
              <dt class="font-bold">Mail de {s.leaderLabel.toLowerCase()}</dt>
              <dd class="break-all">
                <a class="link" href={`mailto:${s.email}`}>
                  {s.email}
                </a>
              </dd>
            </div>
          )
        }
      </dl>
    </aside>
  </div>

  <section aria-labelledby="leiding" class="wrap mt-16">
    <h2 id="leiding" class="text-3xl sm:text-4xl">{s.leaderLabel} {overview?.year.data.label}</h2>
    {
      team && team.members.length > 0 ? (
        <ul class="mt-6 grid grid-cols-2 gap-x-5 gap-y-9 sm:grid-cols-3 lg:grid-cols-6">
          {team.members.map((m) => (
            <LeaderCard leader={m.leader} color={s.color} isLead={m.isLead} showContact />
          ))}
        </ul>
      ) : (
        <p class="mt-4 border-y-2 border-ink py-4 text-muted">De {s.leaderLabel.toLowerCase()} voor dit werkjaar staat nog niet online.</p>
      )
    }
  </section>

  <div class="wrap mt-16 grid gap-x-14 gap-y-14 lg:grid-cols-[1.4fr_1fr]">
    <section aria-labelledby="binnenkort">
      <h2 id="binnenkort" class="text-3xl sm:text-4xl">Binnenkort</h2>
      <p class="mt-1 mb-4 text-muted">Activiteiten van de {s.name.toLowerCase()} en van de hele groep.</p>
      <EventList events={events} sections={sectionMap} limit={5} upcoming />
      <p class="mt-4"><a class="link" href={url(`/kalender/#tak-${section.id}`)}>Hele kalender van de {s.name.toLowerCase()}</a></p>
    </section>

    {
      posts.length > 0 && (
        <section aria-labelledby="berichten">
          <h2 id="berichten" class="text-3xl sm:text-4xl">
            Berichten
          </h2>
          <div class="mt-4 divide-y-2 divide-dotted divide-rule border-y-2 border-ink">
            {posts.map((post) => (
              <PostCard post={post} sections={sectionMap} />
            ))}
          </div>
        </section>
      )
    }
  </div>
</BaseLayout>
