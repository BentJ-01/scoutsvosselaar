---
// Voorlopige tekst: vervangen door de tekst uit docs/huidige-site/inhoud.md (§2 en §7) zodra die er is.
import ContentPage from '@/layouts/ContentPage.astro';
import InfoBlock from '@/components/InfoBlock.astro';
import { rental, site } from '@/site.config';
---

<ContentPage title="Verhuur" description={`De lokalen van ${site.name} huren voor een weekend of kamp, tot ${rental.maxPeople} personen.`}>
  <Fragment slot="intro">Onze lokalen zijn te huur voor weekends en kampen van jeugdbewegingen.</Fragment>

  <InfoBlock title="Wat huur je?">
    <p>De lokalen zijn geschikt voor groepen tot <strong>{rental.maxPeople} personen</strong>, voor weekends en kampen.</p>
  </InfoBlock>

  <InfoBlock title="Beschikbaarheid en reservatie">
    <p>
      De verhuur gebeurt door de vzw van de lokalen.
      {rental.calendarUrl && <a href={rental.calendarUrl}>Bekijk de verhuurkalender</a>}
    </p>
    <p>Je vindt onze lokalen ook op <a href={rental.kampasUrl}>kampas.be</a>.</p>
  </InfoBlock>

  {
    (rental.email || rental.phone) && (
      <InfoBlock title="Contact">
        <ul>
          {rental.email && (
            <li>
              Mail: <a href={`mailto:${rental.email}`}>{rental.email}</a>
            </li>
          )}
          {rental.phone && (
            <li>
              Telefoon: <a href={`tel:${rental.phone.replace(/[^\d+]/g, '')}`}>{rental.phone}</a>
            </li>
          )}
        </ul>
      </InfoBlock>
    )
  }
</ContentPage>
