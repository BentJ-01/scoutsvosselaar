---
import type { GetStaticPaths } from 'astro';
import PostsPage from '@/components/PostsPage.astro';
import { getPosts, type Post } from '@/lib/content';
import { paginate, POSTS_PER_PAGE } from '@/lib/pagination';

export const getStaticPaths = (async () => {
  const pages = paginate(await getPosts(), POSTS_PER_PAGE);
  return pages.slice(1).map((posts, i) => ({ params: { page: String(i + 2) }, props: { posts, page: i + 2, pages: pages.length } }));
}) satisfies GetStaticPaths;

interface Props {
  posts: Post[];
  page: number;
  pages: number;
}
const { posts, page, pages } = Astro.props;
---

<PostsPage posts={posts} page={page} pages={pages} />
