---
/** A leader with photo (or initials on the section color), name and totem. */
import { Image } from 'astro:assets';
import type { Leader } from '@/lib/content';

interface Props {
  leader: Leader;
  color?: string;
  isLead?: boolean;
  /** Show e-mail and phone when filled in. */
  showContact?: boolean;
}
const { leader, color = 'var(--color-brand)', isLead = false, showContact = false } = Astro.props;
const { firstName, lastName, totem, voortotem, photo, email, phone } = leader.data;
const name = `${firstName} ${lastName}`.trim();
const initials = `${firstName.charAt(0)}${lastName.charAt(0)}`.toUpperCase();
---

<li class="flex flex-col items-center text-center">
  <div class="relative">
    {
      photo ? (
        <Image src={photo} alt="" widths={[112, 224]} sizes="7rem" class="size-28 rounded-full object-cover ring-4 ring-card shadow-md" />
      ) : (
        <span
          class="grid size-28 place-items-center rounded-full font-display text-3xl font-extrabold text-white ring-4 ring-card shadow-md"
          style={`background:${color}`}
          aria-hidden="true"
        >
          {initials}
        </span>
      )
    }
    {isLead && <span class="absolute -right-1 bottom-0 rounded-full bg-night px-2 py-0.5 text-[0.7rem] font-bold tracking-wide text-glow uppercase">Takleiding</span>}
  </div>
  <p class="mt-3 font-bold">{name}</p>
  {totem && <p class="text-sm text-muted italic">{voortotem ? `${voortotem} ${totem}` : totem}</p>}
  {
    showContact && (email || phone) && (
      <p class="mt-1 flex flex-col text-sm break-all">
        {email && <a class="inline-block py-1 text-brand underline" href={`mailto:${email}`}>{email}</a>}
        {phone && <a class="inline-block py-1 text-brand underline" href={`tel:${phone.replace(/[^\d+]/g, '')}`}>{phone}</a>}
      </p>
    )
  }
</li>
