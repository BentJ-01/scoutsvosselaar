---
/** A leader with photo (or initials on the section color), name and totem. */
import { Image } from 'astro:assets';
import type { Leader } from '@/lib/content';

interface Props {
  leader: Leader;
  color?: string;
  isLead?: boolean;
  /** Show e-mail and phone when filled in. */
  showContact?: boolean;
}
const { leader, color = 'var(--color-forest-2)', isLead = false, showContact = false } = Astro.props;
const { firstName, lastName, totem, voortotem, photo, email, phone } = leader.data;
const name = `${firstName} ${lastName}`.trim();
const initials = `${firstName.charAt(0)}${lastName.charAt(0)}`.toUpperCase();
---

<li>
  <div class="relative">
    {
      photo ? (
        <Image src={photo} alt="" widths={[176, 320]} sizes="(min-width: 1024px) 10rem, 40vw" class="aspect-[4/5] w-full border-2 border-ink object-cover" />
      ) : (
        <span class="grid aspect-[4/5] w-full place-items-center border-2 border-ink font-display text-4xl font-bold text-white" style={`background:${color}`} aria-hidden="true">
          {initials}
        </span>
      )
    }
    {isLead && <span class="label absolute -bottom-3 left-2 -rotate-3 bg-card text-brand">Takleiding</span>}
  </div>
  <p class="mt-4 font-bold leading-tight">{name}</p>
  {totem && <p class="text-muted">{voortotem ? `${voortotem} ${totem}` : totem}</p>}
  {
    showContact && (email || phone) && (
      <p class="mt-1 flex flex-col text-sm break-all">
        {email && <a class="inline-block py-1 text-brand underline" href={`mailto:${email}`}>{email}</a>}
        {phone && <a class="inline-block py-1 text-brand underline" href={`tel:${phone.replace(/[^\d+]/g, '')}`}>{phone}</a>}
      </p>
    )
  }
</li>
