---
/** Page header on dark green with contour lines. Holds the page's only H1. */
interface Props {
  title: string;
}
const { title } = Astro.props;
---

<section class="bg-forest text-cream topo">
  <div class="wrap pt-10 pb-9 sm:pt-14">
    <slot name="crumbs" />
    <h1 class="text-4xl sm:text-6xl">{title}</h1>
    <div class="mt-3 max-w-2xl text-lg text-cream-muted empty:hidden"><slot /></div>
  </div>
</section>
