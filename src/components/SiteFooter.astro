---
import { site } from '@/site.config';
import { url } from '@/lib/paths';
---

<footer class="mt-20 bg-night text-cream-muted topo">
  <div class="trail -translate-y-1/2"></div>
  <div class="wrap grid gap-8 pt-6 pb-12 sm:grid-cols-[2fr_1.5fr_1fr]">
    <div>
      <p class="font-display text-xl font-bold text-cream">{site.name}</p>
      <p class="mt-1">Groep {site.groupNumber} · {site.federation}</p>
      <p class="mt-3 font-hand text-2xl text-glow">{site.slogan}</p>
    </div>
    <address class="not-italic">
      {site.address.street && <p>{site.address.street}</p>}
      <p>{site.address.postalCode} {site.address.city}</p>
      <p class="mt-2"><a class="underline hover:text-cream" href={`mailto:${site.email}`}>{site.email}</a></p>
    </address>
    <ul class="space-y-1">
      <li><a class="underline hover:text-cream" href={url('/inschrijven/')}>Inschrijven</a></li>
      <li><a class="underline hover:text-cream" href={url('/privacy/')}>Privacy</a></li>
      <li><a class="underline hover:text-cream" href={url('/admin/')}>Beheer</a></li>
    </ul>
  </div>
</footer>
