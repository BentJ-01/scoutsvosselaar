---
import type { Section } from '@/lib/content';
import { url } from '@/lib/paths';

interface Props {
  sections: Section[];
  headingLevel?: 'h2' | 'h3';
}
const { sections, headingLevel = 'h3' } = Astro.props;
const Heading = headingLevel;
---

<ul class="grid grid-cols-2 gap-3 sm:grid-cols-4 lg:grid-cols-7">
  {
    sections.map((s, i) => (
      <li>
        <a
          href={url(`/takken/${s.id}/`)}
          class="group relative flex min-h-32 flex-col justify-end overflow-hidden rounded-[var(--radius-card)] p-4 text-white no-underline shadow-[0_10px_20px_-14px_rgb(0_0_0/0.6)] transition-transform hover:-translate-y-0.5"
          style={`background:${s.data.color}`}
        >
          <span
            aria-hidden="true"
            class="absolute -top-5 -right-5 size-20 rounded-full border-[3px] border-dashed border-white/35"
            style={`transform: rotate(${i * 25}deg)`}
          />
          <Heading class="text-xl font-bold [overflow-wrap:anywhere] hyphens-auto lg:text-[1.05rem] xl:text-lg">{s.data.name}</Heading>
          <span class="text-sm text-white">{s.data.ageRange}</span>
        </a>
      </li>
    ))
  }
</ul>
