---
/**
 * A list of events with date stamps. With `upcoming`, a small script removes
 * events that ended after the build and keeps at most `limit` visible.
 */
import EventItem from './EventItem.astro';
import type { CalendarEvent, Section } from '@/lib/content';

interface Props {
  events: CalendarEvent[];
  sections: Map<string, Section>;
  limit?: number;
  upcoming?: boolean;
  emptyText?: string;
  headingLevel?: 'h2' | 'h3';
}

const { events, sections, limit, upcoming = false, emptyText = 'Er staat nog niets gepland. Kijk binnenkort nog eens.', headingLevel = 'h3' } = Astro.props;
// Extra items, so there is still enough to show once past ones are removed.
const shown = limit === undefined ? events : events.slice(0, limit + 10);
---

<div data-event-list data-limit={limit} data-upcoming={upcoming ? '' : undefined}>
  <ul class="divide-y-2 divide-dotted divide-rule border-y-2 border-ink">
    {shown.map((event, i) => <EventItem event={event} sections={sections} headingLevel={headingLevel} hidden={limit !== undefined && i >= limit} />)}
  </ul>
  <p class="border-b-2 border-ink py-4 text-muted" data-empty hidden={shown.length > 0}>{emptyText}</p>
</div>

<script>
  for (const list of document.querySelectorAll<HTMLElement>('[data-event-list][data-upcoming]')) {
    const now = Date.now();
    const limit = Number(list.dataset.limit ?? Infinity);
    let visible = 0;
    for (const item of list.querySelectorAll<HTMLElement>('[data-ends]')) {
      if (Date.parse(item.dataset.ends ?? '') <= now) {
        item.remove();
        continue;
      }
      item.hidden = visible >= limit;
      visible++;
    }
    const empty = list.querySelector<HTMLElement>('[data-empty]');
    if (empty) empty.hidden = visible > 0;
  }
</script>
