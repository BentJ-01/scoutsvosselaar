---
/** A post as a row: small photo, date, title and summary. */
import { Image } from 'astro:assets';
import { formatDate } from '@/lib/dates';
import { sectionsOf, type Post, type Section } from '@/lib/content';
import { url } from '@/lib/paths';

interface Props {
  post: Post;
  sections: Map<string, Section>;
  headingLevel?: 'h2' | 'h3';
}
const { post, sections, headingLevel = 'h3' } = Astro.props;
const Heading = headingLevel;
const tags = sectionsOf(post.data.sections, sections);
---

<article class:list={['group relative grid gap-4 py-4', post.data.coverImage && 'grid-cols-[5.5rem_1fr] sm:grid-cols-[8rem_1fr]']}>
  {
    post.data.coverImage && (
      <Image src={post.data.coverImage} alt="" widths={[176, 256, 384]} sizes="(min-width: 640px) 8rem, 5.5rem" class="aspect-square w-full border-2 border-ink object-cover" />
    )
  }
  <div>
    <p class="text-sm text-muted">{post.data.date && <time datetime={post.data.date.date}>{formatDate(post.data.date)}</time>}</p>
    <Heading class="text-xl leading-tight">
      <a href={url(`/berichten/${post.id}/`)} class="no-underline after:absolute after:inset-0 group-hover:underline">{post.data.title}</a>
    </Heading>
    <p class="mt-1 line-clamp-2">{post.data.excerpt}</p>
    {
      tags.length > 0 && (
        <p class="mt-1.5 flex flex-wrap gap-x-3">
          {tags.map((s) => (
            <span class="chip" style={`--chip:${s.data.color}`}>
              {s.data.name}
            </span>
          ))}
        </p>
      )
    }
  </div>
</article>
