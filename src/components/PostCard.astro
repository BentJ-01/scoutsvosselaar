---
import { Image } from 'astro:assets';
import { formatDate } from '@/lib/dates';
import { sectionsOf, type Post, type Section } from '@/lib/content';
import { url } from '@/lib/paths';

interface Props {
  post: Post;
  sections: Map<string, Section>;
  headingLevel?: 'h2' | 'h3';
}
const { post, sections, headingLevel = 'h3' } = Astro.props;
const Heading = headingLevel;
const tags = sectionsOf(post.data.sections, sections);
---

<article class="card group relative grid grid-cols-[7rem_1fr] overflow-hidden sm:grid-cols-[11rem_1fr]">
  <div class="relative bg-night-3 topo">
    {
      post.data.coverImage ? (
        <Image src={post.data.coverImage} alt="" widths={[224, 352, 528]} sizes="(min-width: 640px) 11rem, 7rem" class="absolute inset-0 size-full object-cover" />
      ) : (
        <span class="absolute inset-0 grid place-items-center font-hand text-3xl text-glow" aria-hidden="true">
          Scouts
        </span>
      )
    }
  </div>
  <div class="p-4">
    <p class="text-sm text-muted">{post.data.date && <time datetime={post.data.date.date}>{formatDate(post.data.date)}</time>}</p>
    <Heading class="mt-0.5 text-lg font-bold">
      <a href={url(`/berichten/${post.id}/`)} class="no-underline after:absolute after:inset-0 group-hover:underline">{post.data.title}</a>
    </Heading>
    <p class="mt-1 line-clamp-2 text-[0.95rem]">{post.data.excerpt}</p>
    {
      tags.length > 0 && (
        <p class="mt-2 flex flex-wrap gap-1.5">
          {tags.map((s) => (
            <span class="chip" style={`--chip:${s.data.color}`}>
              {s.data.name}
            </span>
          ))}
        </p>
      )
    }
  </div>
</article>
