---
/** Illustration used where no group photo is available yet. */
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
const w = 800;
const h = 560;
const trees = (color: string, baseline: number, count: number) =>
  Array.from({ length: count }, (_, i) => {
    const x = (w / (count - 1)) * i + ((i * 37) % 23) - 11;
    const th = h * (0.22 + ((i * 53) % 17) / 100);
    const y = h * baseline;
    const tw = th * 0.42;
    return `M${x} ${y - th} L${x + tw / 2} ${y - th * 0.45} L${x + tw * 0.32} ${y - th * 0.45} L${x + tw * 0.62} ${y} L${x - tw * 0.62} ${y} L${x - tw * 0.32} ${y - th * 0.45} L${x - tw / 2} ${y - th * 0.45}Z`;
  }).join(' ');
---

<svg viewBox={`0 0 ${w} ${h}`} class={className} role="img" aria-label="Illustratie: een kampvuur tussen de dennen">
  <defs>
    <radialGradient id="cf-glow" cx="50%" cy="85%" r="60%">
      <stop offset="0" stop-color="#ffb04a" stop-opacity=".85"></stop>
      <stop offset=".4" stop-color="#c8562b" stop-opacity=".35"></stop>
      <stop offset="1" stop-color="#1b2a24" stop-opacity="0"></stop>
    </radialGradient>
    <linearGradient id="cf-sky" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#22362d"></stop>
      <stop offset="1" stop-color="#3b2b22"></stop>
    </linearGradient>
  </defs>
  <rect width={w} height={h} fill="url(#cf-sky)"></rect>
  <rect width={w} height={h} fill="url(#cf-glow)"></rect>
  <path d={trees('#14201b', 0.62, 11)} fill="#14201b"></path>
  <rect y={h * 0.62 - 1} width={w} height={h} fill="#14201b"></rect>
  <path d={trees('#0e1713', 0.8, 7)} fill="#0e1713"></path>
  <rect y={h * 0.8 - 1} width={w} height={h} fill="#0e1713"></rect>
  <g transform={`translate(${w / 2} ${h * 0.86})`}>
    <path d="M-46 10 L46 -6 M-46 -6 L46 10" stroke="#3a2416" stroke-width="10" stroke-linecap="round"></path>
    <path d="M0 -70 C 22 -40 30 -20 0 0 C -30 -20 -18 -44 0 -70Z" fill="#ffb04a"></path>
    <path d="M0 -40 C 10 -26 12 -14 0 -2 C -12 -14 -8 -28 0 -40Z" fill="#fff1c9"></path>
  </g>
</svg>
