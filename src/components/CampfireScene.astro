---
/** Flat illustration for where no group photo is available yet. */
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
const w = 800;
const h = 600;
const row = (baseline: number, count: number, seed: number) =>
  Array.from({ length: count }, (_, i) => {
    const x = (w / (count - 1)) * i + ((i * seed) % 23) - 11;
    const th = h * (0.24 + ((i * 53 + seed) % 17) / 100);
    const y = h * baseline;
    const tw = th * 0.4;
    return `M${x} ${y - th} L${x + tw / 2} ${y - th * 0.45} L${x + tw * 0.3} ${y - th * 0.45} L${x + tw * 0.6} ${y} L${x - tw * 0.6} ${y} L${x - tw * 0.3} ${y - th * 0.45} L${x - tw / 2} ${y - th * 0.45}Z`;
  }).join(' ');
---

<svg viewBox={`0 0 ${w} ${h}`} class={className} role="img" aria-label="Tekening: dennen en een kampvuur">
  <rect width={w} height={h} fill="#2b4535"></rect>
  <path d={row(0.66, 11, 37)} fill="#1f3327"></path>
  <rect y={h * 0.66 - 1} width={w} height={h} fill="#1f3327"></rect>
  <path d={row(0.84, 7, 19)} fill="#16261d"></path>
  <rect y={h * 0.84 - 1} width={w} height={h} fill="#16261d"></rect>
  <g transform={`translate(${w / 2} ${h * 0.9})`}>
    <path d="M-44 8 L44 -6 M-44 -6 L44 8" stroke="#6b4a2f" stroke-width="9" stroke-linecap="round"></path>
    <path d="M0 -62 C 20 -36 26 -18 0 0 C -26 -18 -16 -40 0 -62Z" fill="#8c1d2c"></path>
    <path d="M0 -34 C 9 -22 10 -12 0 -2 C -10 -12 -7 -24 0 -34Z" fill="#efe6d2"></path>
  </g>
</svg>
