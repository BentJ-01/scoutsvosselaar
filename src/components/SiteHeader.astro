---
import { navigation, quickLinks } from '@/site.config';
import { isActive, url } from '@/lib/paths';

const pathname = Astro.url.pathname;
---

<header class="sticky top-0 z-30 bg-night text-cream topo">
  <div class="wrap flex items-center gap-3 py-3">
    <a href={url('/')} class="mr-auto leading-none no-underline">
      <span class="block text-[0.7rem] font-semibold tracking-[0.16em] text-glow uppercase">Scouts Don Bosco</span>
      <span class="block font-display text-2xl font-extrabold tracking-tight">Vosselaar</span>
    </a>

    <nav aria-label="Snelkoppelingen" class="flex gap-2 lg:hidden">
      {
        quickLinks.map((item, i) => (
          <a href={url(item.href)} class:list={['btn btn-small', i > 0 && 'btn-outline']}>
            {item.label}
          </a>
        ))
      }
    </nav>

    <button
      type="button"
      class="grid size-10 place-items-center rounded-xl bg-white/10 hover:bg-white/20 lg:hidden"
      aria-expanded="false"
      aria-controls="hoofdmenu"
      data-menu-toggle
    >
      <span class="sr-only">Menu</span>
      <svg aria-hidden="true" viewBox="0 0 24 24" class="size-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
        <path d="M4 7h16M4 12h16M4 17h16"></path>
      </svg>
    </button>

    <nav id="hoofdmenu" aria-label="Hoofdmenu" class="hidden lg:block" data-menu>
      <ul class="flex flex-col gap-1 lg:flex-row lg:gap-0.5">
        {
          navigation.map((item) => (
            <li>
              <a
                href={url(item.href)}
                aria-current={isActive(item.href, pathname) ? 'page' : undefined}
                class="block rounded-lg px-3 py-2 no-underline hover:bg-white/10 aria-[current=page]:text-glow aria-[current=page]:shadow-[inset_0_-2px_0_var(--color-ember)] lg:px-2.5 lg:text-[0.95rem]"
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  @media (max-width: 1023.98px) {
    [data-menu].is-open {
      display: block;
      position: absolute;
      inset: 100% 0 auto;
      max-height: calc(100dvh - 4rem);
      overflow-y: auto;
      padding: 0.5rem 1rem 1rem;
      background: var(--color-night);
      border-top: 1px solid rgb(255 255 255 / 0.1);
      box-shadow: 0 16px 24px -12px rgb(0 0 0 / 0.5);
    }
  }
</style>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = document.querySelector<HTMLElement>('[data-menu]');
  const setOpen = (open: boolean) => {
    toggle?.setAttribute('aria-expanded', String(open));
    menu?.classList.toggle('is-open', open);
  };
  toggle?.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && toggle?.getAttribute('aria-expanded') === 'true') {
      setOpen(false);
      toggle.focus();
    }
  });
</script>
