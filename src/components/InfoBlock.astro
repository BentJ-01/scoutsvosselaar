---
interface Props {
  title: string;
  id?: string;
}
const { title, id = title.toLowerCase().replace(/[^a-z0-9]+/g, '-') } = Astro.props;
---

<section aria-labelledby={id} class="card p-6 sm:p-8">
  <h2 id={id} class="text-2xl font-bold sm:text-3xl">{title}</h2>
  <div class="prose mt-4"><slot /></div>
</section>
